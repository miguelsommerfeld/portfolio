# Ambiente da aplicação
NODE_ENV=development
PORT=3333

# URL do front-end (CORS e redirecionamento pós-login)
FRONTEND_URL=http://localhost:4200

# Credenciais Google OAuth2 (URLs de teste para desenvolvimento local)
GOOGLE_CLIENT_ID=test-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=test-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3333/auth/google/callback

# Segredos para assinatura JWT e cookies (mínimo 32 caracteres)
JWT_SECRET=dev-jwt-secret-change-me-in-production-32chars
COOKIE_SECRET=dev-cookie-secret-change-me-in-production-32chars
JWT_EXPIRES_IN=1h
