{
  "compilerOptions": {
      "types": [
        "node"
      ],
      "paths": {
        "@shared/*": ["./../../shared/*"],
        "@/*": ["./src/*"]
      },
      "rootDir": "./../../",
      "outDir": "dist",
      "strict": true,
      "noEmit": false,
  },
  "include": ["src/**/*", "./../../shared/**/*"]
}
