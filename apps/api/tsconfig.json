{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "paths": {
      "@shared/*": ["./../../shared/*"],
      "@/*": ["./src/*"]
    },
    "rootDir": "./../../",
    "outDir": "dist",
    "strict": true,
    "noEmit": false,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "./../../shared/**/*"]
}
